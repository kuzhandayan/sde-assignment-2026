# Local-development image for the provided simulator (sim/ is unmodified). Used by docker-compose only.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY sim/ sim/
COPY scenarios/ scenarios/
EXPOSE 8700
ENTRYPOINT ["python", "-m", "sim", "serve", "--host", "0.0.0.0", "--port", "8700", "--force"]
